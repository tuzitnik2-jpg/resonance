{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_PASSWORD",
    "API_PORT",
    "WEB_ORIGIN",
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_API_URL",
    "MCP_PORT",
    "RESONANCE_API_URL",
    "MCP_TOKEN_EXPIRES_IN",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
