# Postgres (docker compose exposes 5432)
DATABASE_URL=postgresql://resonance:resonance@localhost:5432/resonance?schema=public
POSTGRES_USER=resonance
POSTGRES_PASSWORD=resonance
POSTGRES_DB=resonance

# API
PORT=8000
API_BASE_URL=http://localhost:8000

# MCP personal bearer token (prototype auth per doc 10.3). Rotate before any real use.
RESONANCE_API_TOKEN=change-me-dev-token

# OpenAI (Phase 3+). Server-side only, never in client bundle.
OPENAI_API_KEY=
