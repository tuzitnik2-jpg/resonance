# Database
DATABASE_URL=postgresql://resonance:resonance@localhost:5432/resonance

# Auth
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=30d
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Ports
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Server-side only: where the web app's Next.js server reaches the API to proxy /api/v1/* calls
# (see apps/web/next.config.js). The browser never talks to this directly.
API_INTERNAL_URL=http://localhost:3001
# Only set this if the API is served from a genuinely different public origin than the web app
# (e.g. a real production deployment). Leave unset for local/dev — see lib/api-client.ts.
# NEXT_PUBLIC_API_URL=

# MCP server (Phase 4 -- ChatGPT connects here; see docs/architecture/mcp.md)
MCP_PORT=3002
RESONANCE_API_URL=http://localhost:3001
# How long a token minted via POST /api/v1/auth/mcp-token stays valid.
MCP_TOKEN_EXPIRES_IN=7d

# AI (Phase 3 -- optional; without this, AI-generated analyses return 503)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.1
